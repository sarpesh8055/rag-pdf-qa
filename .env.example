# Copy this file to .env and fill it in.

# Which LLM to use: "groq" (free cloud API, fast) or "ollama" (runs locally, fully offline)
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Ollama: install from https://ollama.com, then run `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2

# Embedding model from Hugging Face (small, fast, runs on CPU)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
